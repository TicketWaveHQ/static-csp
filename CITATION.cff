    website: "https://ticketwavehq.com"
repository-code: "https://github.com/TicketWaveHQ/static-csp"
license: MIT
keywords:
  - content-security-policy
  - csp
  - csp-hash
  - static-site
  - security-headers
  - astro
  - eleventy
  - hugo
  - nextjs
